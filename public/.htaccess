<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct API routes to PHP endpoints without Node.js
  RewriteRule ^api/quote-request/?$ api/quote-request.php [L,QSA]
  RewriteRule ^api/health/?$ api/health.php [L,QSA]

  # 2. Serve existing files or directories directly
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # 3. Fallback all other client-side routes to index.html (React Router)
  RewriteRule ^.*$ index.html [L]
</IfModule>

# MIME Types & Browser Caching
<IfModule mod_headers.c>
  # 1 Year cache for hashed static assets
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|pdf)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # No-cache for HTML to ensure instant updates
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Enable GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
